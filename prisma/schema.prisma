// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  OPERATOR
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum ConsentType {
  PRIVACY
  MARKETING
  DATA_PROCESSING
  TREATMENT_SPECIFIC
}

enum ConsentStatus {
  GIVEN
  REFUSED
  PENDING
}

enum ReminderStatus {
  NONE
  SCHEDULED
  SENT
  FAILED
}

enum BookingRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum IntegrationType {
  GOOGLE_CALENDAR
  ICAL_URL
}

model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  phone        String?
  email        String?
  logoUrl      String?
  isActive     Boolean  @default(true)
  icsFeedToken String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users                  User[]
  clients                Client[]
  services               Service[]
  products               Product[]
  appointments           Appointment[]
  payments               Payment[]
  consents               Consent[]
  productSales           ProductSale[]
  bookingRequests        BookingRequest[]
  integrations           TenantIntegration[]
  externalCalendarEvents ExternalCalendarEvent[]

  @@map("tenants")
}

model TenantIntegration {
  id                  String          @id @default(cuid())
  tenantId            String
  type                IntegrationType
  isEnabled           Boolean         @default(false)
  externalCalendarUrl String?
  credentials         Json?
  syncToken           String?
  lastSyncedAt        DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events ExternalCalendarEvent[]

  @@unique([tenantId, type])
  @@map("tenant_integrations")
}

model ExternalCalendarEvent {
  id            String   @id @default(cuid())
  tenantId      String
  integrationId String
  externalUid   String
  startTime     DateTime
  endTime       DateTime
  summary       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration TenantIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalUid])
  @@index([tenantId, startTime])
  @@map("external_calendar_events")
}

model User {
  id           String   @id @default(cuid())
  tenantId     String?
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role     @default(OPERATOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[] @relation("AppointmentOperator")

  @@index([tenantId])
  @@map("users")
}

model Client {
  id                  String   @id @default(cuid())
  tenantId            String
  firstName           String
  lastName            String
  phone               String
  email               String?
  notes               String?  @db.Text
  isVip               Boolean  @default(false)
  preferredOperatorId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  consents     Consent[]
  payments     Payment[]
  productSales ProductSale[]

  @@index([tenantId, phone])
  @@index([tenantId, lastName])
  @@map("clients")
}

model Service {
  id                     String   @id @default(cuid())
  tenantId               String
  name                   String
  description            String?  @db.Text
  price                  Decimal  @db.Decimal(10, 2)
  durationMinutes        Int
  isActive               Boolean  @default(true)
  isOnlineBookingEnabled Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  bookingRequests BookingRequest[]

  @@index([tenantId, isActive])
  @@map("services")
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales  ProductSale[]

  @@index([tenantId, isActive])
  @@map("products")
}

model ProductSale {
  id            String   @id @default(cuid())
  tenantId      String
  clientId      String
  productId     String
  appointmentId String?
  quantity      Int      @default(1)
  unitPrice     Decimal  @db.Decimal(10, 2)
  soldAt        DateTime @default(now())
  createdAt     DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, soldAt])
  @@index([clientId])
  @@map("product_sales")
}

model Appointment {
  id             String            @id @default(cuid())
  tenantId       String
  clientId       String
  serviceId      String
  operatorId     String?
  startTime      DateTime
  endTime        DateTime
  status         AppointmentStatus @default(BOOKED)
  price          Decimal?          @db.Decimal(10, 2)
  notes          String?           @db.Text
  reminderStatus ReminderStatus    @default(NONE)
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  operator     User?         @relation("AppointmentOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  payment      Payment?
  productSales ProductSale[]

  @@index([tenantId, startTime])
  @@index([tenantId, status])
  @@map("appointments")
}

model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  clientId      String
  appointmentId String?       @unique
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  notes         String?       @db.Text
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, paidAt])
  @@index([clientId])
  @@map("payments")
}

model Consent {
  id        String        @id @default(cuid())
  tenantId  String
  clientId  String
  type      ConsentType
  status    ConsentStatus @default(PENDING)
  signedAt  DateTime?
  content   String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, type])
  @@index([tenantId])
  @@map("consents")
}

model BookingRequest {
  id            String               @id @default(cuid())
  tenantId      String
  serviceId     String?
  firstName     String
  lastName      String
  phone         String
  email         String?
  preferredDate String?
  preferredTime String?
  notes         String?              @db.Text
  status        BookingRequestStatus @default(PENDING)
  convertedToId String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("booking_requests")
}
