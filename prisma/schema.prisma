// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  OPERATOR
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum AppointmentSource {
  INTERNAL
  ONLINE
}

enum ConsentType {
  PRIVACY_GDPR
  MARKETING
  TREATMENT
}

enum ConsentStatus {
  PENDING
  SIGNED
  REVOKED
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum IntegrationType {
  GOOGLE_CALENDAR
  ICAL_URL
  STRIPE
}

enum BookingProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum PaymentLinkStatus {
  PENDING
  PAID
  CANCELLED
}

enum FormDisplayMode {
  INLINE
  POPUP
}

enum WhatsappDirection {
  INBOUND
  OUTBOUND
}

enum WhatsappMessageStatus {
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
}

/// Quando parte un'automazione (come i trigger dei workflow del CRM, per un centro estetico).
enum AutomationTrigger {
  CLIENT_CREATED
  FORM_SUBMITTED
  BOOKING_REQUESTED
  APPOINTMENT_CONFIRMED
  BEFORE_APPOINTMENT
  AFTER_APPOINTMENT
  BIRTHDAY
  CLIENT_INACTIVE
  QUESTIONNAIRE
  WHATSAPP_RECEIVED
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum AutomationRunStatus {
  RUNNING
  WAITING
  COMPLETED
  FAILED
  STOPPED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  COMPLETED
  FAILED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Tenant {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  phone             String?
  email             String?
  logoUrl           String?
  isActive          Boolean  @default(true)
  /// Incassi in cassa (Incassa, POS, contanti). Spento: niente sezione Pagamenti,
  /// incasso stimato dai trattamenti e appuntamenti passati completati da soli.
  paymentsEnabled   Boolean  @default(false)
  /// Prenotazioni online confermate subito (come Treatwell/Fresha): l'agenda
  /// mostra solo orari liberi negli orari di lavoro. Spento: le conferma il centro.
  autoConfirmOnline Boolean  @default(true)
  /// Consensi informati (modelli, firme, avviso "Consenso" in agenda). Spento: tutto nascosto.
  consentsEnabled   Boolean  @default(true)
  icsFeedToken      String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users                  User[]
  clients                Client[]
  services               Service[]
  appointments           Appointment[]
  integrations           TenantIntegration[]
  externalCalendarEvents ExternalCalendarEvent[]
  consentTemplates       ConsentTemplate[]
  consentRecords         ConsentRecord[]
  payments               Payment[]
  questionnaires         ClientQuestionnaire[]
  workingHours           WorkingHours[]
  staffExceptions        StaffException[]
  staffBlocks            StaffBlock[]
  clientPlans            ClientPlan[]
  forms                  Form[]
  formSubmissions        FormSubmission[]
  whatsappConnection     WhatsappConnection?
  whatsappMessages       WhatsappMessage[]
  automations            Automation[]
  automationRuns         AutomationRun[]
  campaigns              Campaign[]
  paymentLinks           PaymentLink[]
  whatsappHistoryChunks  WhatsappHistoryChunk[]
  dataImports            DataImport[]
  bookingProposals       BookingProposal[]

  @@map("tenants")
}

model TenantIntegration {
  id                  String          @id @default(cuid())
  tenantId            String
  type                IntegrationType
  isEnabled           Boolean         @default(false)
  externalCalendarUrl String?
  credentials         Json?
  syncToken           String?
  lastSyncedAt        DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events ExternalCalendarEvent[]

  @@unique([tenantId, type])
  @@map("tenant_integrations")
}

model ExternalCalendarEvent {
  id            String   @id @default(cuid())
  tenantId      String
  integrationId String
  externalUid   String
  startTime     DateTime
  endTime       DateTime
  summary       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration TenantIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalUid])
  @@index([tenantId, startTime])
  @@map("external_calendar_events")
}

model User {
  id                String    @id @default(cuid())
  tenantId          String?
  email             String    @unique
  passwordHash      String
  firstName         String
  lastName          String
  role              Role      @default(OPERATOR)
  isActive          Boolean   @default(true)
  /// Posizione della colonna in agenda (vista operatrici): più basso = più a sinistra.
  agendaOrder       Int       @default(0)
  /// Identità in Fusion ID (claim sub), collegata al primo accesso con Fusion ID.
  fusionIdSub       String?   @unique
  /// Le sessioni emesse prima di questa data non valgono più ("esci ovunque" da Fusion Control).
  sessionsRevokedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant            Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments      Appointment[]    @relation("AppointmentOperator")
  extraTreatments   AppointmentExtraService[] @relation("ExtraServiceOperator")
  collectedConsents ConsentRecord[]  @relation("ConsentCollectedBy")
  payments          Payment[]        @relation("PaymentCreatedBy")
  workingHours      WorkingHours[]
  staffExceptions   StaffException[]
  staffBlocks       StaffBlock[]
  // Trattamenti che l'operatrice NON esegue (di default li fa tutti).
  excludedServices  Service[]        @relation("OperatorExcludedServices")

  @@index([tenantId])
  @@map("users")
}

model Client {
  id                String    @id @default(cuid())
  tenantId          String
  firstName         String
  lastName          String
  phone             String
  email             String?
  notes             String?   @db.Text
  dateOfBirth       DateTime? @db.Date
  taxCode           String?
  // Campi popolati dal questionario inviato via WhatsApp (o compilati a mano).
  city              String?
  allergies         String?   @db.Text
  healthNotes       String?   @db.Text
  acquisitionSource String?
  interests         String[]  @default([])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments     Appointment[]
  consents         ConsentRecord[]
  payments         Payment[]
  questionnaires   ClientQuestionnaire[]
  plans            ClientPlan[]
  formSubmissions  FormSubmission[]
  whatsappMessages WhatsappMessage[]
  automationRuns   AutomationRun[]
  campaignEntries  CampaignRecipient[]
  paymentLinks     PaymentLink[]

  @@index([tenantId, phone])
  @@index([tenantId, lastName])
  @@map("clients")
}

model Service {
  id                     String   @id @default(cuid())
  tenantId               String
  name                   String
  description            String?  @db.Text
  price                  Decimal  @db.Decimal(10, 2)
  durationMinutes        Int
  isActive               Boolean  @default(true)
  isOnlineBookingEnabled Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments        Appointment[]
  // Trattamenti aggiunti a un appuntamento con più trattamenti (il primo resta in Appointment.serviceId).
  extraInAppointments AppointmentExtraService[]
  consentTemplates    ConsentTemplate[]
  // Consensi informati richiesti per questo trattamento (un modello vale per più trattamenti).
  requiredConsents    ConsentTemplate[]         @relation("ConsentTemplateServices")
  excludedOperators   User[]                    @relation("OperatorExcludedServices")

  @@index([tenantId, isActive])
  @@map("services")
}

model Appointment {
  id         String            @id @default(cuid())
  tenantId   String
  clientId   String
  serviceId  String
  operatorId String?
  startTime  DateTime
  endTime    DateTime
  status     AppointmentStatus @default(BOOKED)
  source     AppointmentSource @default(INTERNAL)
  notes      String?           @db.Text
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client        Client                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  service       Service                   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  operator      User?                     @relation("AppointmentOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  consents      ConsentRecord[]
  payment       Payment?
  paymentLinks  PaymentLink[]
  proposals     BookingProposal[]
  /// Altri trattamenti nello stesso appuntamento, in ordine (es. Manicure + Pedicure).
  extraServices AppointmentExtraService[]

  @@index([tenantId, startTime])
  @@index([tenantId, status])
  @@map("appointments")
}

/// Trattamento in più di un appuntamento: prezzo e durata copiati al momento della prenotazione.
model AppointmentExtraService {
  id              String  @id @default(cuid())
  appointmentId   String
  serviceId       String
  position        Int
  price           Decimal @db.Decimal(10, 2)
  durationMinutes Int
  /// Chi fa questo trattamento, se non è l'operatrice dell'appuntamento (vuoto = la stessa).
  operatorId      String?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  operator    User?       @relation("ExtraServiceOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([serviceId])
  @@index([operatorId])
  @@map("appointment_extra_services")
}

model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  clientId      String
  // Un solo incasso per appuntamento.
  appointmentId String?       @unique
  /// Rata o saldo di un percorso (pacchetto di sedute).
  planId        String?
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  notes         String?
  isPrivate     Boolean       @default(false)
  paidAt        DateTime      @default(now())
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  plan        ClientPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, paidAt])
  @@index([clientId])
  @@index([planId])
  @@map("payments")
}

// Questionario inviato alla cliente (link WhatsApp): le risposte popolano la scheda.
model ClientQuestionnaire {
  id          String    @id @default(cuid())
  tenantId    String
  clientId    String
  token       String    @unique
  sentAt      DateTime?
  completedAt DateTime?
  answers     Json?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_questionnaires")
}

model ConsentTemplate {
  id        String      @id @default(cuid())
  tenantId  String
  type      ConsentType
  // Per i consensi TREATMENT: trattamento a cui il modello si riferisce (facoltativo).
  // Vecchio campo singolo: i nuovi modelli usano `services` (più trattamenti).
  serviceId String?
  title     String
  body      String      @db.Text
  // Condizioni di salute da spuntare prima della firma (anamnesi); vuoto = solo note libere.
  checklist String[]    @default([])
  // Incrementata a ogni modifica del testo; i record firmati conservano la versione firmata.
  version   Int         @default(1)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service  Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  services Service[]       @relation("ConsentTemplateServices")
  records  ConsentRecord[]

  @@index([tenantId, type, isActive])
  @@map("consent_templates")
}

model ConsentRecord {
  id            String        @id @default(cuid())
  tenantId      String
  clientId      String
  appointmentId String?
  templateId    String
  collectedById String?
  status        ConsentStatus @default(PENDING)

  // Snapshot immutabile di ciò che la cliente ha effettivamente firmato.
  templateVersion Int
  titleSnapshot   String  @db.Text
  bodySnapshot    String  @db.Text
  // Risposte di anamnesi (consenso informato), se presenti.
  answers         Json?
  // Consenso accordato (utile per MARKETING, dove la firma può essere un rifiuto esplicito).
  granted         Boolean @default(true)

  // Chiavi relative alla radice dello storage (volume Docker), non percorsi assoluti.
  signatureKey String?
  pdfKey       String?
  // SHA-256 del PDF generato, per verificarne l'integrità.
  documentHash String?

  token     String?   @unique
  ipAddress String?
  userAgent String?   @db.Text
  signedAt  DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  appointment Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  template    ConsentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  collectedBy User?           @relation("ConsentCollectedBy", fields: [collectedById], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId])
  @@index([tenantId, status])
  @@index([appointmentId])
  @@map("consent_records")
}

model WorkingHours {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
  @@index([tenantId, userId])
  @@map("working_hours")
}

model StaffException {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  date      DateTime @db.Date
  startTime String?
  endTime   String?
  note      String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([userId, date])
  @@map("staff_exceptions")
}

model ClientPlan {
  id            String     @id @default(cuid())
  tenantId      String
  clientId      String
  name          String
  totalSessions Int
  totalPrice    Decimal    @db.Decimal(10, 2)
  paidAmount    Decimal    @default(0) @db.Decimal(10, 2)
  notes         String?    @db.Text
  status        PlanStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client       Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessions     ClientPlanSession[]
  payments     Payment[]
  paymentLinks PaymentLink[]

  @@index([tenantId, clientId])
  @@map("client_plans")
}

model ClientPlanSession {
  id            String    @id @default(cuid())
  planId        String
  sessionNumber Int
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  plan ClientPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, sessionNumber])
  @@map("client_plan_sessions")
}

// ── Form incorporabili nei siti ──────────────────────────────────────────────
// Come i form del CRM: script da incollare in qualsiasi sito, in linea o come
// bolla popup. Ogni invio crea o aggiorna la scheda cliente (stesso telefono).
model Form {
  id             String          @id @default(cuid())
  tenantId       String
  name           String
  /// Titolo mostrato al visitatore; `name` è solo l'etichetta interna.
  title          String
  fields         Json
  settings       Json
  displayMode    FormDisplayMode @default(INLINE)
  color          String          @default("#1f3d36")
  welcomeMessage String          @default("")
  enabled        Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]

  @@index([tenantId])
  @@map("forms")
}

model FormSubmission {
  id        String   @id @default(cuid())
  tenantId  String
  formId    String
  clientId  String
  payload   Json
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
  @@index([clientId])
  @@map("form_submissions")
}

// ── WhatsApp tramite Fusion WA ───────────────────────────────────────────────
// Fusion WA custodisce token Meta e webhook: qui resta solo quale numero è
// collegato al centro (externalCustomerId = tenant.id) per instradare i
// messaggi in arrivo, che portano il phone_number_id.
model WhatsappConnection {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  wabaId        String
  phoneNumberId String   @unique
  phoneNumber   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_connections")
}

model WhatsappMessage {
  id           String                @id @default(cuid())
  tenantId     String
  clientId     String?
  /// Numero della cliente in formato internazionale senza "+" (es. 393331234567).
  phone        String
  direction    WhatsappDirection
  status       WhatsappMessageStatus
  body         String                @db.Text
  templateName String?
  /// Foto, vocale, video o documento: id del file su Meta (si scarica tramite Fusion WA) e tipo.
  mediaId      String?
  mediaType    String?
  wamid        String?               @unique
  error        String?
  /// Evita doppi invii automatici (es. "reminder:<appointmentId>").
  dedupeKey    String?
  readAt       DateTime?
  createdAt    DateTime              @default(now())

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client            Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaignRecipient CampaignRecipient?

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, phone, createdAt])
  @@index([tenantId, createdAt])
  @@map("whatsapp_messages")
}

/// Import da un altro gestionale (es. GoHighLevel): stato e numeri, per la pagina di import.
model DataImport {
  id         String    @id @default(cuid())
  tenantId   String
  source     String
  status     String    @default("RUNNING")
  stats      Json      @default("{}")
  error      String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("data_imports")
}

/// Blocchi grezzi dello storico chat dell'app WhatsApp Business (Coexistence):
/// Meta li manda una volta sola, si tengono per poterli rielaborare.
model WhatsappHistoryChunk {
  id          String   @id @default(cuid())
  tenantId    String
  contentHash String   @unique
  payload     Json
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("whatsapp_history_chunks")
}

// ── Automazioni (come i workflow del CRM, semplificate) ──────────────────────
// Un'automazione è un trigger più una lista di passi (JSON, vedi
// src/lib/automations.ts): invia template o testo WhatsApp, attendi,
// condizione sì/no, nota sulla scheda, interesse. Ogni cliente che entra è un
// AutomationRun, che il worker riprende alla fine delle attese.
model Automation {
  id            String            @id @default(cuid())
  tenantId      String
  name          String
  status        AutomationStatus  @default(DRAFT)
  trigger       AutomationTrigger
  /// Impostazioni del trigger (es. ore prima dell'appuntamento, form, giorni di inattività).
  triggerConfig Json              @default("{}")
  steps         Json              @default("[]")
  /// Messaggi solo tra le 9 e le 20: fuori orario il passo aspetta l'apertura.
  quietHours    Boolean           @default(true)
  /// La stessa cliente può rientrare (es. ogni appuntamento, ogni compleanno).
  allowReentry  Boolean           @default(true)
  /// Si ferma se la cliente risponde su WhatsApp.
  stopOnReply   Boolean           @default(false)
  /// Modello di partenza (compleanno, promemoria…), solo informativo.
  presetKey     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   AutomationRun[]

  @@index([tenantId, trigger, status])
  @@map("automations")
}

model AutomationRun {
  id            String              @id @default(cuid())
  tenantId      String
  automationId  String
  clientId      String
  status        AutomationRunStatus @default(RUNNING)
  /// Passo da eseguire alla ripresa (null = dall'inizio / finito).
  currentStepId String?
  resumeAt      DateTime?
  /// Una sola corsa per evento (es. "appointment:<id>:<inizio>", "birthday:2026").
  triggerKey    String
  /// Dati dell'evento per le variabili ({{trattamento}}, {{data}}, {{link}}…).
  context       Json                @default("{}")
  /// Diario dei passi: [{at, step, ok, message}].
  log           Json                @default("[]")
  lastError     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([automationId, triggerKey])
  @@index([status, resumeAt])
  @@index([automationId, createdAt])
  @@index([clientId])
  @@map("automation_runs")
}

// ── Campagne WhatsApp ────────────────────────────────────────────────────────
// Un template approvato a un gruppo di clienti (pubblico in JSON, vedi
// src/lib/campaigns.ts), inviato a scaglioni dal worker. Le statistiche di
// consegna/lettura arrivano dal messaggio collegato (WhatsappMessage).
model Campaign {
  id                   String         @id @default(cuid())
  tenantId             String
  name                 String
  status               CampaignStatus @default(DRAFT)
  templateName         String
  language             String
  templateBody         String         @default("")
  params               String[]       @default([])
  audience             Json           @default("{}")
  scheduledAt          DateTime?
  batchSize            Int            @default(40)
  batchIntervalMinutes Int            @default(10)
  nextBatchAt          DateTime?
  totalRecipients      Int            @default(0)
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]

  @@index([tenantId, createdAt])
  @@index([status, nextBatchAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String                  @id @default(cuid())
  campaignId String
  clientId   String
  status     CampaignRecipientStatus @default(PENDING)
  /// WhatsappMessage inviato: da lì consegnato / letto / risposto.
  messageId  String?                 @unique
  error      String?
  sentAt     DateTime?

  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  client   Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  message  WhatsappMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([campaignId, clientId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

// ── Proposte di un altro orario (richieste online) ───────────────────────────
// Il centro propone un orario diverso: la cliente riceve un WhatsApp con i
// pulsanti "Sì, confermo" / "Scelgo un altro orario" e la risposta (legata al
// messaggio inviato) sposta e conferma l'appuntamento da sola.
model BookingProposal {
  id            String                @id @default(cuid())
  tenantId      String
  appointmentId String
  proposedStart DateTime
  proposedEnd   DateTime
  operatorId    String?
  /// WhatsappMessage della proposta: la risposta lo cita (context.id = wamid).
  messageId     String?               @unique
  status        BookingProposalStatus @default(PENDING)
  respondedAt   DateTime?
  createdAt     DateTime              @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("booking_proposals")
}

// ── Link di pagamento (Stripe del centro) ────────────────────────────────────
// Un link /paga/<token> per un trattamento: a ogni apertura crea una Checkout
// Session sullo Stripe del centro (carta, Klarna in 3 rate, Satispay… secondo i
// metodi attivi), così il link non scade. Il webhook lo segna pagato.
model PaymentLink {
  id              String            @id @default(cuid())
  tenantId        String
  clientId        String
  appointmentId   String?
  /// Rata o saldo di un percorso: pagato, si somma al percorso.
  planId          String?
  /// Importo in centesimi.
  amountCents     Int
  description     String
  token           String            @unique
  status          PaymentLinkStatus @default(PENDING)
  stripeSessionId String?
  stripePaymentId String?
  /// Metodo usato (card, klarna, satispay…), quando Stripe lo comunica.
  paidWith        String?
  paidAt          DateTime?
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  plan        ClientPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([appointmentId])
  @@index([planId])
  @@map("payment_links")
}

// ── Impegni dello staff ──────────────────────────────────────────────────────
// Pausa, ferie, visita medica, corso: in agenda come blocco grigio, e in quelle
// ore l'operatrice non è prenotabile (online e da agenda).
model StaffBlock {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  startTime   DateTime
  endTime     DateTime
  title       String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, startTime])
  @@index([userId, startTime])
  @@map("staff_blocks")
}
