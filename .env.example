# --- App ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Production only: host port the app container binds to on 127.0.0.1
# (behind the Apache reverse proxy). See docker-compose.prod.yml.
APP_PORT=3013
APP_BASE_URL="http://localhost:3000"

# --- Database (Prisma / PostgreSQL) --------------------------------------
POSTGRES_USER=fusion_beauty
POSTGRES_PASSWORD=fusion_beauty
POSTGRES_DB=fusion_beauty
# Used by the app/worker when running via docker compose (host = service name).
DATABASE_URL="postgresql://fusion_beauty:fusion_beauty@localhost:5432/fusion_beauty?schema=public"

# --- Redis / BullMQ -------------------------------------------------------
REDIS_URL="redis://localhost:6379"
# Production only: password enforced via --requirepass in docker-compose.prod.yml.
REDIS_PASSWORD=fusion_beauty

# --- Auth (NextAuth / Auth.js) --------------------------------------------
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Production seed (prisma/seed.prod.ts) --------------------------------
# SEED_SUPER_ADMIN_EMAIL=admin@example.com
# SEED_SUPER_ADMIN_PASSWORD=            # omit to auto-generate and print once

# --- File storage (signatures, consent PDFs) -----------------------------
# Root directory; in Docker this is a persistent volume mounted at /data/storage.
STORAGE_DIR="./data/storage"

# ── Fusion ID (login unico) e Fusion Kit ─────────────────────────────────────
# Valori generati da fusion-id/scripts/setup.mjs (out/prod/env/<prodotto>.env).
# Senza FUSION_ID_* resta solo il login con password di prima.
FUSION_ID_ISSUER=
FUSION_ID_CLIENT_ID=
FUSION_ID_CLIENT_SECRET=
FUSION_ID_GOOGLE_IDP_ID=
FUSION_ID_APP_URL=
# on = resta anche il vecchio login con password; off = solo Fusion ID
FUSION_ID_LEGACY_LOGIN=on
FUSION_KIT_PRODUCT=
FUSION_KIT_SECRET=
FUSION_CONTROL_URL=https://crm.fusionsoft.it
